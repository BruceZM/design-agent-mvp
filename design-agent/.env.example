# Only local, single-owner execution. Never expose this server to the internet.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-5.3-flash
# Native multimodal image parsing; no automatic retry or fallback.
VISION_MODE=remote
# Same Coding Plan endpoint verified for GLM-5.3-Flash image inputs.
VISION_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
VISION_MODEL=glm-5.3-flash
MAX_MODEL_CALLS=16
MAX_REPAIRS=1
TASK_TIMEOUT_SECONDS=900
# Target defaults to sibling ../customer-manager; base branch is fixed main.
