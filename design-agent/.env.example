# 本地配置模板：复制为 .env 后填写密钥；.env 已被 Git 忽略。
# 当前服务面向单人本地使用，启动脚本只监听 127.0.0.1。
# API key 仅供后端读取，不写进前端、提示词、Git 或本文件。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-5.3-flash
# 设计稿原图交给多模态模型解析；失败时停止，没有自动重试或 OCR 回退。
VISION_MODE=remote
# 视觉地址与编码地址可分开配置，默认均使用 Coding Plan 入口。
VISION_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
VISION_MODEL=glm-5.3-flash
# 计划 + 编码 + 修复共用调用次数上限，1～20；不包含前面的视觉调用。
MAX_MODEL_CALLS=16
# 独立检查失败后的修复次数，0～2；1 表示首次开发后至多再开发一轮。
MAX_REPAIRS=1
# Developer 初始化后，在每次模型调用前检查已用时间；不是全流程硬取消计时器。
TASK_TIMEOUT_SECONDS=900
# 目标固定为同级 ../customer-manager，基线固定 main；网页没有任意仓库入口。
