{
  "theme": "base",
  "securityLevel": "strict",
  "fontFamily": "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Arial, sans-serif",
  "themeVariables": {
    "fontSize": "17px",
    "primaryColor": "#E1F4FF",
    "primaryBorderColor": "#0878F9",
    "primaryTextColor": "#202B38",
    "lineColor": "#596673",
    "clusterBkg": "#F5F7FA",
    "clusterBorder": "#C6CDD5",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#E1F4FF",
    "actorBorder": "#0878F9",
    "actorTextColor": "#202B38",
    "actorLineColor": "#0878F9",
    "signalColor": "#303A46",
    "signalTextColor": "#202B38",
    "noteBkgColor": "#F0F4FA",
    "noteBorderColor": "#BFCBDA",
    "noteTextColor": "#202B38"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "nodeSpacing": 24,
    "rankSpacing": 25,
    "padding": 10,
    "useMaxWidth": false,
    "wrappingWidth": 480,
    "minNodeWidth": 0
  },
  "sequence": {
    "useMaxWidth": false,
    "actorMargin": 28,
    "width": 136,
    "height": 46,
    "messageMargin": 8,
    "noteMargin": 5,
    "mirrorActors": false,
    "actorFontSize": 16,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "boxMargin": 5,
    "boxTextMargin": 4,
    "diagramMarginY": 6
  },
  "markdownAutoWrap": false
}
